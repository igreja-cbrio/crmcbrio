# ── Worker env vars ──────────────────────────────────────────
# Copie para .env (local) ou configure no Railway dashboard (prod).

# Anthropic API key (Console → API Keys)
ANTHROPIC_API_KEY=

# Supabase (mesmo banco do CBRio ERP)
SUPABASE_URL=https://hhntwfawfnxvuobhdfkb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Segredo compartilhado com o backend Vercel — usado pra autenticar
# requests vindas do crmcbrio.vercel.app. Gera com:
#   openssl rand -hex 32
WORKER_SECRET=

# Porta (Railway injeta PORT automaticamente)
PORT=3030

# Timezone do scheduler (cron interno)
CRON_TZ=America/Sao_Paulo

# Liga/desliga o scheduler — em dev local mantenha 0, em prod 1.
ENABLE_SCHEDULER=0

# Default: pula confirmação de permissão das tools (já restringimos
# allowedTools só pras nossas).
PERMISSION_MODE=acceptEdits
